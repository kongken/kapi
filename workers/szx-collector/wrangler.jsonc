{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapi-szx-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "KAPI_BASE_URL": "https://kapi.lovec.at"
  }
}
